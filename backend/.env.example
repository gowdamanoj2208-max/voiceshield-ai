# Copy to .env for local backend configuration. Leave the AI values empty for demo mode.
ZAI_API_KEY=
ZAI_API_BASE=

# Optional SQLite location; defaults to backend/voiceshield.db
# VOICESHIELD_DB_PATH=backend/voiceshield.db

# Optional local Vite origin for development CORS.
CORS_ORIGIN=http://127.0.0.1:5173

